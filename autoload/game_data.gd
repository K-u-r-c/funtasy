extends Node
## Loads every definition from res://data (JSON) once at startup and validates it.
## The rest of the game reads balance numbers and definitions only through here.
##
## Single-file tables: balance, assets, game_settings, input_defaults, rarities, affixes,
## consumables, status_effects, props.
## Directory tables (one JSON object per file, keyed by its "id"): classes, monsters, bosses,
## floor_types, item_bases (data/items/bases/*.json).
## Skills and talents: data/skills/<class>.json and data/talents/<class>.json (arrays / trees).

const DATA_DIR := "res://data/"

var balance: Dictionary = {}
var assets: Dictionary = {}
var game_settings: Array = []
var input_defaults: Dictionary = {}
var rarities: Array = []
var affixes: Dictionary = {}
var consumables: Dictionary = {}
var status_effects: Dictionary = {}
var props: Dictionary = {}
var classes: Dictionary = {}
var skills: Dictionary = {}  ## skill id -> def (all classes + monster skills)
var talents: Dictionary = {}  ## class id -> tree def
var monsters: Dictionary = {}
var bosses: Dictionary = {}
var floor_types: Dictionary = {}
var item_bases: Dictionary = {}
var damage_types: Dictionary = {}  ## data/damage_types.json (types, school_default, creature_types)
var elite_modifiers: Dictionary = {}
var floor_modifiers: Dictionary = {}  ## #71
var floor_events: Dictionary = {}  ## #72: data/floor_events.json
var boons: Dictionary = {}  ## #73: boon id -> def (data/boons/*.json)
var boon_tags: Dictionary = {}  ## #73: tag id -> {name}
var merchants: Dictionary = {}
var pact_consumables: Dictionary = {}
var item_looks: Dictionary = {}  ## data/items/looks.json: worn families, variants (#20)
var legendaries: Dictionary = {}  ## id -> def (data/items/legendaries.json is an array)
var lore_books: Dictionary = {}  ## id -> def (generated by tools/import_lore.py)
var lore_order: Array = []  ## lore ids in book order
var obstacles: Dictionary = {}  ## dynamic terrain kinds (data/obstacles.json)
var doors: Dictionary = {}  ## door types of the sealed chambers (data/doors.json, #23 / #31)
var fx: Dictionary = {}  ## visual effects by role and element (data/fx.json, #33 / #34)

var errors: PackedStringArray = []

const REQUIRED := {
	"classes": ["id", "name", "resource", "skills", "base_stats", "per_level", "primary_attack"],
	"skills": ["id", "name", "cooldown", "effects"],
	"monsters": ["id", "name", "ai", "base_stats", "xp", "sprite"],
	"bosses": ["id", "name", "base_stats", "xp", "sprite", "phases"],
	"floor_types": ["id", "name", "monsters", "music", "tiles"],
	"item_bases": ["id", "name", "slot", "icon"],
}


func _ready() -> void:
	reload()


func reload() -> void:
	errors.clear()
	balance = _load_json("balance.json", {})
	# Generated placeholder art first, the hand-kept registry on top (real art wins).
	assets = _load_json("assets_placeholders.json", {}) if FileAccess.file_exists(DATA_DIR + "assets_placeholders.json") else {}
	_deep_merge(assets, _load_json("assets.json", {}))
	game_settings = _load_json("game_settings.json", [])
	input_defaults = _load_json("input_defaults.json", {})
	rarities = _load_json("items/rarities.json", [])
	affixes = _load_json("items/affixes.json", {})
	consumables = _load_json("items/consumables.json", {})
	status_effects = _load_json("status_effects.json", {})
	props = _load_json("props.json", {})
	damage_types = _load_json("damage_types.json", {})
	obstacles = _load_json("obstacles.json", {})
	elite_modifiers = _load_json("elite_modifiers.json", {})
	floor_modifiers = _load_json("floor_modifiers.json", {})
	floor_events = _load_json("floor_events.json", {})
	boon_tags.clear()
	for t in _load_json("boon_tags.json", []):
		boon_tags[t.id] = t
	boons.clear()
	for file in _list_json("boons"):
		for b in _load_json("boons/" + file, []):
			boons[b.id] = b
	merchants = _load_json("merchants.json", {})
	doors = _load_json("doors.json", {})
	fx = _load_json("fx.json", {})
	pact_consumables = _load_json("items/pact_consumables.json", {})
	item_looks = _load_json("items/looks.json", {})
	legendaries.clear()
	for l in _load_json("items/legendaries.json", []):
		legendaries[l.id] = l
	lore_books.clear()
	lore_order.clear()
	for b in _load_json("lore_books.json", []):
		lore_books[b.id] = b
		lore_order.append(b.id)
	classes = _load_dir("classes")
	monsters = _load_dir("monsters")
	bosses = _load_dir("bosses")
	floor_types = _load_dir("floor_types")
	item_bases = _load_dir("items/bases")
	skills.clear()
	talents.clear()
	for file in _list_json("skills"):
		var arr: Variant = _load_json("skills/" + file, [])
		for s in arr:
			skills[s.id] = s
	for file in _list_json("talents"):
		talents[file.get_basename()] = _load_json("talents/" + file, {})
	for table in [status_effects, obstacles, elite_modifiers, pact_consumables, props, consumables, merchants]:
		table.erase("_comment")
	# Pact potions are consumables too (bought from Malphas, used from Q / E).
	for pid in pact_consumables:
		var pc: Dictionary = pact_consumables[pid].duplicate()
		pc.pact = true
		pc.max_stack = 1
		pc.weight = 0
		pc.cooldown = 1.0
		pc.sfx = "potion"
		consumables["pact_" + pid] = pc
	_validate()
	_validate_refs()
	for e in errors:
		push_error("GameData: " + e)


static func _deep_merge(into: Dictionary, over: Dictionary) -> void:
	for k in over:
		if into.get(k) is Dictionary and over[k] is Dictionary:
			_deep_merge(into[k], over[k])
		else:
			into[k] = over[k]


## D7 / D15: a level-30 number scaled down for a lower level.
func level_scale(level: int) -> float:
	var lo := float(bal("level_scale.floor", 0.2))
	return lo + (1.0 - lo) * clampf(float(level) / float(bal("level_scale.max_level", 30)), 0.0, 1.0)


func bal(path: String, fallback: Variant = null) -> Variant:
	## Dotted lookup into balance.json, e.g. bal("player.move_speed").
	var node: Variant = balance
	for part in path.split("."):
		if node is Dictionary and node.has(part):
			node = node[part]
		else:
			if fallback == null:
				push_error("GameData: missing balance key '%s'" % path)
			return fallback
	return node


func asset_path(key: String) -> String:
	## Asset registry lookup (data/assets.json, dotted key). Swapping art = editing that file.
	var node: Variant = assets
	for part in key.split("."):
		if node is Dictionary and node.has(part):
			node = node[part]
		else:
			push_error("GameData: missing asset key '%s'" % key)
			return ""
	return str(node.path) if node is Dictionary and node.has("path") else str(node)


func asset_entry(key: String) -> Dictionary:
	var node: Variant = assets
	for part in key.split("."):
		if node is Dictionary and node.has(part):
			node = node[part]
		else:
			push_error("GameData: missing asset key '%s'" % key)
			return {}
	return node if node is Dictionary else {"path": str(node)}


func texture(key: String) -> Texture2D:
	var path := asset_path(key)
	if path.is_empty() or not ResourceLoader.exists(path):
		push_error("GameData: texture not found for '%s' (%s)" % [key, path])
		return null
	return load(path)


func skill(id: String) -> Dictionary:
	if not skills.has(id):
		push_error("GameData: unknown skill '%s'" % id)
		return {}
	return skills[id]


func rarity(tier: int) -> Dictionary:
	return rarities[clampi(tier, 1, rarities.size()) - 1]


func game_setting_def(id: String) -> Dictionary:
	for d in game_settings:
		if d.id == id:
			return d
	return {}


# --- Loading -------------------------------------------------------------------------------


func _load_json(rel: String, fallback: Variant) -> Variant:
	var path := DATA_DIR + rel
	if not FileAccess.file_exists(path):
		errors.append("missing file %s" % path)
		return fallback
	var text := FileAccess.get_file_as_string(path)
	var json := JSON.new()
	if json.parse(text) != OK:
		errors.append("%s:%d: %s" % [path, json.get_error_line(), json.get_error_message()])
		return fallback
	return json.data


func _list_json(rel_dir: String) -> PackedStringArray:
	var out: PackedStringArray = []
	var dir := DirAccess.open(DATA_DIR + rel_dir)
	if dir == null:
		errors.append("missing directory %s" % rel_dir)
		return out
	for f in dir.get_files():
		if f.ends_with(".json"):
			out.append(f)
	out.sort()
	return out


func _load_dir(rel_dir: String) -> Dictionary:
	var out := {}
	for f in _list_json(rel_dir):
		var d: Variant = _load_json(rel_dir + "/" + f, {})
		if d is Dictionary and d.has("id"):
			out[d.id] = d
		else:
			errors.append("%s/%s has no id" % [rel_dir, f])
	return out


func _validate() -> void:
	var tables := {
		"classes": classes, "skills": skills, "monsters": monsters, "bosses": bosses,
		"floor_types": floor_types, "item_bases": item_bases,
	}
	for table_name in REQUIRED:
		for id in tables[table_name]:
			var def: Dictionary = tables[table_name][id]
			for key in REQUIRED[table_name]:
				if not def.has(key):
					errors.append("%s '%s' is missing '%s'" % [table_name, id, key])
	for cid in classes:
		for sid in classes[cid].skills:
			if not skills.has(sid):
				errors.append("class '%s' references unknown skill '%s'" % [cid, sid])
		if not talents.has(cid):
			errors.append("class '%s' has no talent tree" % cid)
	for fid in floor_types:
		var ft: Dictionary = floor_types[fid]
		for m in ft.monsters:
			if not monsters.has(m.id):
				errors.append("floor type '%s' references unknown monster '%s'" % [fid, m.id])
		if not ft.has("boss") and not ft.has("bosses"):
			errors.append("floor type '%s' has no boss" % fid)
		for bid in ft.get("bosses", [ft.get("boss", "")]):
			if not bosses.has(bid):
				errors.append("floor type '%s' references unknown boss '%s'" % [fid, bid])


# --- Reference validation (full GDD content) --------------------------------------------------
# Only broken references are errors: content that isn't written yet is simply absent.

const BEHAVIOR_DIR := "res://scripts/enemies/behaviors/"
const BOSS_MECHANIC_DIR := "res://scripts/enemies/boss_mechanics/"
const FLOOR_MECHANIC_DIR := "res://scripts/dungeon/mechanics/"


func damage_type_of(skill: Dictionary, eff: Dictionary = {}) -> String:
	if eff.has("damage_type"):
		return str(eff.damage_type)
	if skill.has("damage_type"):
		return str(skill.damage_type)
	return str(damage_types.get("school_default", {}).get(str(skill.get("school", "melee")), "physical"))


func asset_exists(key: String) -> bool:
	var node: Variant = assets
	for part in key.split("."):
		if node is Dictionary and node.has(part):
			node = node[part]
		else:
			return false
	return true


func _validate_refs() -> void:
	var types: Dictionary = damage_types.get("types", {})
	var creatures: Array = damage_types.get("creature_types", [])
	for sid in skills:
		var sk: Dictionary = skills[sid]
		if sk.has("damage_type") and not types.has(sk.damage_type):
			errors.append("skill '%s' has unknown damage_type '%s'" % [sid, sk.damage_type])
		if sk.has("icon") and not asset_exists("icons." + str(sk.icon)):
			errors.append("skill '%s' has unknown icon '%s'" % [sid, sk.icon])
		_validate_effects("skill '%s'" % sid, sk.get("effects", []) + sk.get("on_cast", []) + sk.get("channel", {}).get("tick_effects", []), types)
		_validate_procs("skill '%s'" % sid, sk.get("procs", []), types)
	for stid in status_effects:
		var st: Dictionary = status_effects[stid]
		if st.has("damage_type") and not types.has(st.damage_type):
			errors.append("status '%s' has unknown damage_type '%s'" % [stid, st.damage_type])
		_validate_procs("status '%s'" % stid, st.get("procs", []), types)
		for key in ["on_expire", "on_end", "on_apply", "tick_effects"]:
			_validate_effects("status '%s'" % stid, st.get(key, []), types)
		_validate_effects("status '%s'" % stid, st.get("threshold", {}).get("effects", []), types)
		if st.has("threshold") and st.threshold.has("apply") and not status_effects.has(str(st.threshold.apply)):
			errors.append("status '%s' threshold applies unknown status '%s'" % [stid, st.threshold.apply])
	for table in [monsters, bosses]:
		for mid in table:
			var m: Dictionary = table[mid]
			var what := "monster '%s'" % mid
			if m.has("creature_type") and not creatures.has(m.creature_type):
				errors.append("%s has unknown creature_type '%s'" % [what, m.creature_type])
			for t in m.get("resist", {}):
				if not types.has(t):
					errors.append("%s resists unknown damage type '%s'" % [what, t])
			for t in m.get("immune", []):
				if not types.has(t):
					errors.append("%s is immune to unknown damage type '%s'" % [what, t])
			if not asset_exists(str(m.get("sprite", ""))):
				errors.append("%s has unknown sprite '%s'" % [what, m.get("sprite", "")])
			for b in m.get("behaviors", []):
				_need_script(what, BEHAVIOR_DIR, str(b.get("id", "")))
			for sid2 in m.get("ai", {}).get("abilities", []):
				if not skills.has(sid2):
					errors.append("%s uses unknown skill '%s'" % [what, sid2])
			for ph in m.get("phases", []):
				for sid3 in ph.get("abilities", []) + ph.get("on_enter", []):
					if not skills.has(sid3):
						errors.append("%s phase uses unknown skill '%s'" % [what, sid3])
				for mech in ph.get("mechanics", []):
					_need_script(what, BOSS_MECHANIC_DIR, str(mech.get("id", "")))
	for fid in floor_types:
		var ft: Dictionary = floor_types[fid]
		for bid in ft.get("bosses", []):
			if not bosses.has(bid):
				errors.append("floor type '%s' references unknown boss '%s'" % [fid, bid])
		for mech2 in ft.get("floor_mechanics", []):
			_need_script("floor type '%s'" % fid, FLOOR_MECHANIC_DIR, str(mech2.get("id", "")))
	for cid in talents:
		var tree: Dictionary = talents[cid]
		var branches := {}
		for b2 in tree.get("branches", []):
			branches[b2.id] = true
		for node in tree.get("nodes", []):
			if node.has("branch") and not branches.has(node.branch):
				errors.append("talent '%s' has unknown branch '%s'" % [node.id, node.branch])
			if node.has("skill") and not skills.has(node.skill):
				errors.append("talent '%s' unlocks unknown skill '%s'" % [node.id, node.skill])
			for m2 in node.get("mods", []):
				if m2.has("skill"):
					for msk in (m2.skill if m2.skill is Array else [m2.skill]):
						if msk != "*" and msk != "*traps" and not skills.has(msk):
							errors.append("talent '%s' modifies unknown skill '%s'" % [node.id, msk])
			_validate_procs("talent '%s'" % node.id, node.get("procs", []), types)
		for p in tree_problems(tree):
			errors.append("talent tree '%s': %s" % [cid, p])
	for eid in elite_modifiers:
		_validate_procs("elite modifier '%s'" % eid, elite_modifiers[eid].get("procs", []), types)
	for pid in pact_consumables:
		_validate_effects("pact '%s'" % pid, pact_consumables[pid].get("effects", []), types)
	for lid in legendaries:
		var l: Dictionary = legendaries[lid]
		if not item_bases.has(str(l.get("base", ""))):
			errors.append("legendary '%s' has unknown base '%s'" % [lid, l.get("base", "")])
		if l.has("class") and not classes.has(l["class"]):
			errors.append("legendary '%s' has unknown class '%s'" % [lid, l["class"]])
		if l.has("icon") and not asset_exists(str(l.icon)):
			errors.append("legendary '%s' has unknown icon '%s'" % [lid, l.icon])
		_validate_procs("legendary '%s'" % lid, l.get("procs", []), types)


## #47: what is wrong with a talent tree as a graph ([] = nothing): every tier-0 node is a root
## and every other node has one prerequisite in its branch on a lower tier (`requires`), so the
## tree has no cycles and every node is reachable from a root; keystones are leaves (nothing
## requires them); a fork (`exclusive`) is two siblings of one prerequisite; no two nodes share a
## (branch, tier, col) cell; each branch has a fork in tiers 1-2; and whichever side of each fork
## is taken, every tier's gate (`tier` x `tier_points`, or a node's own `branch_points`) can be
## paid from the nodes that stay open below it.
static func tree_problems(tree: Dictionary) -> Array:
	var out: Array = []
	var nodes := {}
	for n in tree.get("nodes", []):
		nodes[str(n.id)] = n
	var tp := int(tree.get("tier_points", 2))
	var cells := {}
	var required := {}
	for id in nodes:
		var n: Dictionary = nodes[id]
		var reqs: Array = n.get("requires", [])
		var cell := "%s:%d:%d" % [n.get("branch", ""), int(n.get("tier", 0)), int(n.get("col", -1))]
		if cells.has(cell):
			out.append("%s and %s share a cell" % [id, cells[cell]])
		cells[cell] = id
		if int(n.get("tier", 0)) == 0:
			if not reqs.is_empty():
				out.append("%s is on tier 0 but has a prerequisite" % id)
			continue
		if reqs.is_empty():
			out.append("%s has no prerequisite" % id)
		for r in reqs:
			var p: Dictionary = nodes.get(str(r), {})
			if p.is_empty() or p.get("branch", "") != n.get("branch", "") or int(p.get("tier", 0)) >= int(n.get("tier", 0)):
				out.append("%s requires %s, not a lower node of its branch" % [id, r])
			required[str(r)] = true
	for id in nodes:
		if str(nodes[id].get("type", "")) == "keystone" and required.has(id):
			out.append("keystone %s is required by another node" % id)
	for br in tree.get("branches", []):
		var bn: Array = nodes.values().filter(func(x): return x.get("branch", "") == br.id)
		var groups := {}
		for n in bn:
			if n.has("exclusive"):
				groups[str(n.exclusive)] = groups.get(str(n.exclusive), []) + [n]
		var early := false
		for g in groups:
			var sides: Array = groups[g]
			if sides.size() != 2 or sides[0].get("requires", []) != sides[1].get("requires", []):
				out.append("fork %s is not two siblings" % g)
			early = early or sides.any(func(x): return int(x.get("tier", 0)) <= 2)
		if not early:
			out.append("branch %s has no fork in tiers 1-2" % br.id)
		# Every combination of fork sides: the nodes left open must pay every gate.
		var keys: Array = groups.keys()
		for combo in range(1 << keys.size()):
			var shut := {}
			for gi in keys.size():
				shut[str(groups[keys[gi]][(combo >> gi) & 1].id)] = true
			var open := {}
			for t in 6:
				for n in bn:
					if int(n.get("tier", 0)) == t and not shut.has(str(n.id)):
						var ok := true
						for r in n.get("requires", []):
							ok = ok and open.has(str(r))
						if ok:
							open[str(n.id)] = n
			for t in range(1, 6):
				var below := 0
				var need := t * tp
				var any := false
				for n in open.values():
					if int(n.get("tier", 0)) < t and not n.get("starter", false):
						below += int(n.get("max_rank", 1))
					if int(n.get("tier", 0)) == t:
						any = true
						need = maxi(need, int(n.get("branch_points", 0)))
				if any and below < need:
					out.append("branch %s: tier %d needs %d points but only %d are open below" % [br.id, t, need, below])
	return out


func _need_script(what: String, dir: String, id: String) -> void:
	if id.is_empty() or not ResourceLoader.exists(dir + id + ".gd"):
		errors.append("%s references unknown script '%s%s.gd'" % [what, dir, id])


func _validate_effects(what: String, effects: Array, types: Dictionary) -> void:
	for eff in effects:
		if not eff is Dictionary:
			errors.append("%s has a malformed effect" % what)
			continue
		var t := str(eff.get("type", ""))
		if not Combat.EFFECT_TYPES.has(t) and not Combat.ON_HIT_TYPES.has(t):
			errors.append("%s uses unknown effect type '%s'" % [what, t])
		if eff.has("status") and not status_effects.has(str(eff.status)):
			errors.append("%s applies unknown status '%s'" % [what, eff.status])
		if eff.has("damage_type") and not types.has(str(eff.damage_type)):
			errors.append("%s has unknown damage_type '%s'" % [what, eff.damage_type])
		for key in ["on_hit", "on_arrive", "effects", "on_end", "tick_effects", "on_start", "path_on_hit", "ally_effects",
				"on_taunted", "on_interrupt", "snap_effects"]:
			if eff.has(key):
				_validate_effects(what, eff[key], types)
		if eff.has("explode"):
			_validate_effects(what, [eff.explode.merged({"type": "aoe"}, false)], types)


func _validate_procs(what: String, procs: Array, types: Dictionary) -> void:
	for pr in procs:
		if pr.has("event") and not Combat.PROC_EVENTS.has(str(pr.event)):
			errors.append("%s has a proc on unknown event '%s'" % [what, pr.event])
		if pr.has("hook") and not LegendaryAffixes.has_hook(str(pr.hook)):
			errors.append("%s uses unknown hook '%s'" % [what, pr.hook])
		_validate_effects(what, pr.get("do", []), types)
