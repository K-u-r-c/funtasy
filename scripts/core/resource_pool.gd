class_name ResourcePool
extends Node
## Mana or Fury. Host-only logic; value/max reach clients via the actor's state synchronizer.
## Mana regenerates slowly (rate from Stats). Fury is generated by dealing and taking damage and
## decays after a while out of combat.

var kind := "none"  ## "mana", "fury" or "none"
var value: float = 0.0
var max_value: float = 0.0
var regen_per_second := 0.0  ## set by Stats.recompute()
var _since_combat := 999.0


func setup(new_kind: String, new_max: float, start_full: bool) -> void:
	kind = new_kind
	max_value = new_max
	value = new_max if start_full and kind != "fury" else 0.0


func set_max(new_max: float) -> void:
	max_value = maxf(new_max, 0.0)
	value = minf(value, max_value)


func can_pay(cost: float) -> bool:
	return value >= cost - 0.001


func pay(cost: float) -> bool:
	if not can_pay(cost):
		return false
	value = maxf(value - cost, 0.0)
	return true


func gain(amount: float) -> void:
	value = clampf(value + amount, 0.0, max_value)


func mark_combat() -> void:
	_since_combat = 0.0


func fraction() -> float:
	return clampf(value / max_value, 0.0, 1.0) if max_value > 0.0 else 0.0


func _process(delta: float) -> void:
	if not multiplayer.is_server() or kind == "none":
		return
	_since_combat += delta
	if kind == "mana":
		gain(regen_per_second * delta)
	elif kind == "fury" and _since_combat > float(GameData.bal("fury.decay_delay")):
		gain(-float(GameData.bal("fury.decay_per_second")) * delta)
