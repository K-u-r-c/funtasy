; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="funtasy"
config/version="0.1.9"
run/main_scene="res://scenes/menus/main_menu.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false

[autoload]

McpBridgeGame="*res://mcp_bridge_game.gd"
EventBus="*res://autoload/event_bus.gd"
GameData="*res://autoload/game_data.gd"
SaveSystem="*res://autoload/save_system.gd"
Settings="*res://autoload/settings.gd"
InputSettings="*res://autoload/input_settings.gd"
AudioManager="*res://autoload/audio_manager.gd"
NetworkManager="*res://autoload/network_manager.gd"
GameState="*res://autoload/game_state.gd"
Codex="*res://autoload/codex.gd"
SceneManager="*res://autoload/scene_manager.gd"
DevAuto="*res://autoload/dev_auto.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/mcp_bridge/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://data/i18n/translations.pl.translation")

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="players"
2d_physics/layer_3="enemies"
2d_physics/layer_4="props"
2d_physics/layer_5="doors"

[physics]

2d/default_gravity=0.0

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
